# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Configuration (Google Gemini — optional, falls back to rule-based)
GEMINI_API_KEY=your_gemini_api_key_here

# Security: Comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow all users (development mode)
ALLOWED_USER_IDS=123456789,987654321

# Admin chat ID for receiving proactive monitoring alerts
ADMIN_CHAT_ID=123456789

# Monitoring interval in seconds (default: 1800 = 30 minutes)
MONITOR_INTERVAL=1800

# Application Configuration
LOG_LEVEL=INFO

# Security First: Always default to True
DRY_RUN_DEFAULT=True
